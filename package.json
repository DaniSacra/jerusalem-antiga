{
  "name": "jerusalem-antiga",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "node scripts/visual/run.mjs",
    "sim": "rolldown tools/sim/run.ts --file node_modules/.cache/sim/run.mjs --platform node --format esm && node node_modules/.cache/sim/run.mjs",
    "test:pwa": "node scripts/pwa-check.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
